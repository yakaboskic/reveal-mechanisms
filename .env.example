# Shared application/importer configuration. New colleagues: see README.local.md.
# Prefer scripts/local_setup.py --bundle <encrypted-file> for a working clone.
# Both importers and the Prisma CLI read the repository-root .env automatically.
# Existing shell variables take precedence; explicit CLI flags override defaults.
# Quote secrets, especially values containing spaces or #. Values are not shell code.

# REQUIRED for generating embeddings and free-text semantic queries.
EMBEDDING_SERVICE_API_KEY=''

# Lab embedding service defaults (already configured).
EMBEDDING_SERVICE_URL=https://embedding-service-27386110942.us-east1.run.app
EMBEDDING_MODEL=pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb
EMBEDDING_PROVIDER=huggingface
# Set a known deployment revision when available; otherwise keep unspecified.
EMBEDDING_MODEL_REVISION=unspecified

# REQUIRED for noninteractive AWS database loading; blank prompts in Python.
REVEAL_MYSQL_PASSWORD=''

# Existing Aurora project database (already configured).
REVEAL_MYSQL_HOST=aurora-giant-bioindex.cluster-cxrzznxifeib.us-east-1.rds.amazonaws.com
REVEAL_MYSQL_PORT=3306
REVEAL_MYSQL_USER=cyaka
REVEAL_MYSQL_DATABASE=cyaka_reveal_mechanisms

# Absolute path to a trusted RDS CA bundle (.pem). Required by local Compose.
# Standalone importers can use the system trust store when blank; TLS stays on.
REVEAL_MYSQL_CA_FILE=''

# Optional Prisma CLI override; otherwise the URL is built from REVEAL_MYSQL_*.
# Passwords in a URL must be percent-encoded. Keep this blank to reuse the above.
DATABASE_URL=''

# LOCAL APPLICATION (configure once; never commit .env)
# Generate each secret independently, for example: openssl rand -hex 32
AUTH_SECRET=''
# For NextAuth v4 compatibility, use the same value as AUTH_SECRET.
NEXTAUTH_SECRET=''
NEXTAUTH_URL=http://localhost:3000
REVEAL_GATEWAY_SECRET=''
REVEAL_GATEWAY_SERVICE_TOKEN=''
REVEAL_GATEWAY_ISSUER=reveal-nextjs
REVEAL_GATEWAY_AUDIENCE=reveal-api
# Optional local backend API key: store only its SHA-256 and existing owner UUID.
# Leave both blank to disable. Never put the raw colleague key in this file.
# Cloud configuration uses separate private qa/prod-api-key-config.json records.
REVEAL_API_KEY_SHA256=''
REVEAL_API_KEY_USER_ID=''
REVEAL_API_URL=http://127.0.0.1:8000
# Optional canonical direct MCP URL base (include any service prefix, omit /mcp).
# Defaults to the Workflow callback origin/prefix. Hosted Box runs require a
# publicly reachable HTTPS base; local agents can use the loopback API URL.
REVEAL_PUBLIC_API_URL=
# Canonical browser URL for downloaded local-workspace reconnect links.
# Required with a remote public API; loopback development defaults to localhost:3000.
REVEAL_PUBLIC_WEB_URL=
# Enable only after verifying BioIndex deployment access and both small-model
# phenotype index signatures; other BioIndex operations stay unavailable.
REVEAL_SMALL_PHENOTYPE_VERIFIED=false
REVEAL_API_PORT=8000
REVEAL_FRONTEND_PORT=3000
REVEAL_ENVIRONMENT=development
# Local deployment defaults to reveal-compose for the original checkout.
# Handoff import creates a unique reveal-local-... namespace per clone.
# All clones retain the existing reveal_* tables; only worker queues are separate.
REVEAL_JOB_NAMESPACE=

# OAuth providers are optional for anonymous access. Configure to enable sign-in.
AUTH_GOOGLE_ID=''
AUTH_GOOGLE_SECRET=''
AUTH_ORCID_ID=''
AUTH_ORCID_SECRET=''
AUTH_ORCID_ISSUER=https://orcid.org

# Scientific runtime. Box is the default; deterministic is development/test only.
REVEAL_EXECUTION_MODE=box
UPSTASH_BOX_API_KEY=''
# Durable delivery. Copy token and both signing keys from the same QStash region.
REVEAL_JOB_TRANSPORT=workflow
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=''
QSTASH_CURRENT_SIGNING_KEY=''
QSTASH_NEXT_SIGNING_KEY=''
# Full externally reachable versioned callback; local helper configures this.
REVEAL_WORKFLOW_URL=''
# Pub/Sub subscription only: no Redis queue, polling, or recurring PING.
UPSTASH_REDIS_REST_URL=''
UPSTASH_REDIS_REST_TOKEN=''
REVEAL_NOTIFICATION_NAMESPACE=reveal-local
# Serving uses the verified active snapshot; imports use the write token.
REVEAL_RETRIEVAL_BACKEND=upstash
REVEAL_VECTOR_ENVIRONMENT=local
UPSTASH_VECTOR_REST_URL=''
UPSTASH_VECTOR_REST_TOKEN=''
UPSTASH_VECTOR_WRITE_TOKEN=''
ANTHROPIC_API_KEY=''
# Research and paragraph authoring model. Use an exact Claude API model ID.
# Alternatives: claude-opus-5-5 or claude-fable-5-1 (subject to API access).
REVEAL_CLAUDE_MODEL=claude-sonnet-4-6
REVEAL_AGENT_TIMEOUT_SECONDS=900
REVEAL_AGENT_MAX_BUDGET_USD=3
REVEAL_AGENT_MAX_TURNS=100
# Canonical owner-authorized scientific resolver used by citations.
REVEAL_CANONICAL_URL=http://localhost:3000
# Trusted host DAPPER checkout; Compose overrides this to its container path.
REVEAL_DAPPER_ROOT=./.runtime/dapper
REVEAL_ARTIFACTS_DIR=./.runtime/artifacts
# Existing DisMech checkout used only for exact frozen source YAML bytes.
REVEAL_DISMECH_SOURCE=../dismech
# Run IDs are source bindings; saved selections retain their original runs.
REVEAL_MAPPING_RUN_ID=272cfa19d093257863d7e7134776229dbc9b9b018d974e6b311285686833ec31
# Optional when more than one compatible DisMech embedding run is complete.
# Automatic suggestions require a completed run matching the selected sources.
REVEAL_DISMECH_EMBEDDING_RUN_ID=

# Admin console at /admin. Emails must come from a verified OAuth callback.
ADMIN_EMAILS=chase@broadinstitute.org,cyakabos@broadinstitute.org
# Bypass works only with next dev (NODE_ENV=development), never production.
DISABLE_ADMIN_LOGIN=false

# Offline demo prioritization: needed only for prioritize_demo_gaps.py run --send.
TYPESAFE_API_KEY=''
