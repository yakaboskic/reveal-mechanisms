model EagglCfdeLinkRun {
  run_id             String                 @id @db.Char(64)
  eaggl_import_id    String                 @db.Char(64)
  gene_set_import_id String                 @db.Char(64)
  model              String                 @db.VarChar(64)
  match_method       String                 @db.VarChar(64)
  status             String                 @db.VarChar(16)
  manifest           Json
  created_at         DateTime               @default(now()) @db.Timestamp(0)
  eaggl_imports      EagglImport            @relation(fields: [eaggl_import_id], references: [import_id], onDelete: NoAction, onUpdate: NoAction, map: "link_run_source_fk")
  gene_set_imports   GeneSetImport          @relation(fields: [gene_set_import_id], references: [import_id], onDelete: NoAction, onUpdate: NoAction, map: "link_run_gene_sets_fk")
  factor_links       EagglCfdeFactorLink[]
  gene_set_links     EagglCfdeGeneSetLink[]

  @@unique([run_id, eaggl_import_id], map: "link_run_eaggl")
  @@unique([run_id, gene_set_import_id], map: "link_run_gene_sets")
  @@index([eaggl_import_id], map: "link_run_source")
  @@index([gene_set_import_id], map: "link_run_gene_set_import")
  @@map("eaggl_cfde_link_runs")
}

model EagglCfdeFactorLink {
  run_id             String                 @db.Char(64)
  factor_index       Int                    @db.UnsignedInt
  eaggl_import_id    String                 @db.Char(64)
  cfde_node_id       String                 @db.Text
  cfde_node_sha256   String                 @db.Char(64)
  cfde_trait         String                 @db.Text
  cfde_factor_number Int                    @db.UnsignedInt
  cfde_trait_group   String                 @db.VarChar(64)
  payload            Json
  run                EagglCfdeLinkRun       @relation(fields: [run_id, eaggl_import_id], references: [run_id, eaggl_import_id], onDelete: NoAction, onUpdate: NoAction, map: "factor_link_run_fk")
  eaggl_factors      EagglFactor            @relation(fields: [eaggl_import_id, factor_index], references: [import_id, factor_index], onDelete: NoAction, onUpdate: NoAction, map: "factor_link_source_fk")
  gene_set_links     EagglCfdeGeneSetLink[]

  @@id([run_id, factor_index])
  @@unique([run_id, cfde_node_sha256], map: "cfde_factor_link_target")
  @@index([run_id, eaggl_import_id], map: "cfde_factor_link_run")
  @@index([eaggl_import_id, factor_index], map: "cfde_factor_link_source")
  @@map("eaggl_cfde_factor_links")
}

model EagglCfdeGeneSetLink {
  run_id                String              @db.Char(64)
  factor_index          Int                 @db.UnsignedInt
  gene_set_rank         Int                 @db.UnsignedInt
  gene_set_import_id    String              @db.Char(64)
  source_key            String              @db.Text
  node_id               String              @db.Text
  node_id_sha256        String              @db.Char(64)
  resolved_alias_sha256 String?             @db.Char(64)
  factor                EagglCfdeFactorLink @relation(fields: [run_id, factor_index], references: [run_id, factor_index], onDelete: NoAction, onUpdate: NoAction, map: "gene_set_link_factor_fk")
  run                   EagglCfdeLinkRun    @relation(fields: [run_id, gene_set_import_id], references: [run_id, gene_set_import_id], onDelete: NoAction, onUpdate: NoAction, map: "gene_set_link_run_fk")
  alias                 CfdeGeneSetAlias?   @relation(fields: [gene_set_import_id, resolved_alias_sha256], references: [import_id, node_id_sha256], onDelete: NoAction, onUpdate: NoAction, map: "gene_set_link_alias_fk")

  @@id([run_id, factor_index, gene_set_rank])
  @@index([run_id, gene_set_import_id], map: "cfde_gene_set_link_run")
  @@index([gene_set_import_id, resolved_alias_sha256], map: "cfde_gene_set_link_alias")
  @@map("eaggl_cfde_gene_set_links")
}
