  dismech_documents DismechDocument @relation(fields: [import_id, document_sha256], references: [import_id, id_sha256], onDelete: NoAction, onUpdate: NoAction, map: "dismech_hypotheses_ibfk_1")

  @@id([import_id, id_sha256])
  @@index([import_id, document_sha256], map: "import_id")
  @@map("dismech_hypotheses")
}

