{"nodes": [{"id": "docs_design_plan", "label": "design-plan.md", "file_type": "document", "source_file": "docs/design-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_plan_contract_precedence", "label": "Contract authority and precedence", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current plan owns product behavior; OpenAPI owns public wire shapes; evidence LinkML owns input shape; pinned DAPPER owns scientific identity. Resolve conflicts in contracts before implementation."}, {"id": "docs_design_plan_dismech_gap_only", "label": "DisMech KnowledgeGap selection", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free text is a lookup query. Preserve imported gap text and revision; curated mechanisms are read-only source context."}, {"id": "docs_design_plan_crosswalk_retrieval", "label": "Initial crosswalk-backed retrieval", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search existing BioBERT label vectors and join completed exact trait/factor mappings before the top-five cutoff. Full current-model re-embedding and biological agreement are not prerequisites."}, {"id": "docs_design_plan_one_round_expansion", "label": "Frozen-seed one-round CFDE expansion", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four direct expansions use one frozen seed set, followed by contextual edges. Returned factors never become new seeds."}, {"id": "docs_design_plan_application_architecture", "label": "Next.js / FastAPI / EC2 / Aurora architecture", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent browser frontend, REST API and worker use Aurora as system of record; components exist but the integrated services remain unbuilt."}, {"id": "docs_design_plan_scientific_application_boundary", "label": "Scientific identity and application ownership boundary", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DAPPER represents scientific objects; application envelopes represent users, jobs, rankings, selections and aliases. Digest deduplication never grants access."}, {"id": "docs_design_plan_pinned_agent_runtime", "label": "Pinned DAPPER research-agent runtime", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every attempt clones and verifies DAPPER 0.2.0-a1; historical input pins are allowed explicitly without rewriting old objects. Box/Claude/MCP isolation remains worker integration work."}, {"id": "docs_design_plan_account_acceptance", "label": "Trusted scientific account acceptance", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "170", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend supplies true actors/runtime, resolves IDs and reruns final lint. Additional grounding, ownership and scientific-faithfulness gates precede atomic persistence."}, {"id": "docs_design_plan_paragraph_outbox", "label": "Automatic cited-Paragraph outbox", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each accepted account transactionally queues a separate paragraph job, deduplicated by payload observation and citation/skill pins. Paragraph failure leaves accepted accounts usable."}, {"id": "docs_design_plan_citation_registry", "label": "Versioned citation registry", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Metadata revisions live outside the target digest; fixed pins and code-point spans prevent bibliography drift. Rendered formatting does not change scientific identity."}, {"id": "docs_design_plan_job_lifecycle", "label": "Durable job lifecycle", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "191", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MySQL queue uses attempts, leases, heartbeat and execution IDs; reconcile Box before restarting paid work and guard against stale terminal writes."}, {"id": "docs_design_plan_payload_observations", "label": "DAPPER payload observations", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Digest identity and exact payload identity differ. Permitted unhashable changes append payload hashes rather than overwriting records used by earlier claims."}, {"id": "docs_design_plan_personal_workspace", "label": "Owned gap/account dashboard", "file_type": "rationale", "source_file": "docs/design-plan.md", "source_location": "186", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two dashboard tabs project immutable request/job history. Anonymous possession and registered identity are distinct from historical scientific authorship."}], "edges": [{"source": "docs_design_plan", "target": "