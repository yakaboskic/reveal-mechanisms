{
  "name": "@reveal/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "generate": "openapi-typescript ../../api/openapi.json -o src/lib/api.generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "fixtures": "node scripts/generate-fixtures.mjs"
  },
  "dependencies": {
    "next": "15.5.26",
    "next-auth": "4.24.15",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "jose": "5.10.0",
    "openapi-fetch": "0.14.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "typescript": "5.9.3",
    "openapi-typescript": "7.13.0",
    "tsx": "4.21.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.23",
    "esbuild": "0.28.1"
  }
}
