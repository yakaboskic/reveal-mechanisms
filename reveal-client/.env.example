# Run npm run setup -- --credentials /absolute/path/to/dk-qa.env.
# These are backend-only credentials. Never use a NEXT_PUBLIC_ variable.
REVEAL_API_URL=
REVEAL_GATEWAY_SECRET=
REVEAL_GATEWAY_SERVICE_TOKEN=
REVEAL_GATEWAY_ISSUER=reveal-nextjs
REVEAL_GATEWAY_AUDIENCE=reveal-api
REVEAL_ARTIFACT_DOWNLOAD_BASE_URLS=
AUTH_SECRET=
APP_ORIGIN=http://localhost:3200
# The fixed demo identity is usable only on this loopback origin.
# A hosted app must replace the demo session adapter with its own login.
REVEAL_DEMO_MODE=false
DEMO_IDENTITY_ISSUER=urn:reveal:client:dk
DEMO_IDENTITY_SUBJECT=developer
