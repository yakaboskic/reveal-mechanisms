{
  "name": "reveal-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3200",
    "generate": "openapi-typescript openapi.json -o src/lib/api.generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.* scripts/*.test.mjs"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "jose": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "typescript": "5.9.3",
    "openapi-typescript": "7.13.0",
    "tsx": "4.21.0"
  },
  "engines": {"node": ">=22"},
  "overrides": {"postcss": "8.5.23", "esbuild": "0.28.1"}
}
