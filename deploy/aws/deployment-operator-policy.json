{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassOnlyRevealRuntimeToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::005901288866:role/cyaka-reveal-ec2",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    },
    {
      "Sid": "InspectRevealRuntimeIdentity",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:GetInstanceProfile"],
      "Resource": ["arn:aws:iam::005901288866:role/cyaka-reveal-ec2", "arn:aws:iam::005901288866:instance-profile/cyaka-reveal-ec2"]
    },
    {
      "Sid": "AuthenticateRegistry",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PublishRevealImages",
      "Effect": "Allow",
      "Action": ["ecr:DescribeRepositories", "ecr:DescribeImages", "ecr:BatchGetImage", "ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart", "ecr:CompleteLayerUpload", "ecr:PutImage"],
      "Resource": "arn:aws:ecr:us-east-1:005901288866:repository/cyaka-reveal-backend"
    },
    {
      "Sid": "ConfigureRevealBackendSecret",
      "Effect": "Allow",
      "Action": ["secretsmanager:CreateSecret", "secretsmanager:PutSecretValue", "secretsmanager:DescribeSecret", "secretsmanager:TagResource"],
      "Resource": "arn:aws:secretsmanager:us-east-1:005901288866:secret:cyaka/reveal/backend-*"
    },
    {
      "Sid": "UseShellDocumentOnReveal",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
    },
    {
      "Sid": "AdministerTaggedRevealHost",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-east-1:005901288866:instance/*",
      "Condition": {"StringEquals": {"ssm:resourceTag/Project": "reveal-mechanisms"}}
    },
    {
      "Sid": "InspectRevealLogs",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents"],
      "Resource": ["arn:aws:logs:us-east-1:005901288866:log-group:/cyaka/reveal/backend", "arn:aws:logs:us-east-1:005901288866:log-group:/cyaka/reveal/backend:*"]
    },
    {
      "Sid": "ReadCommandStatus",
      "Effect": "Allow",
      "Action": ["ssm:DescribeInstanceInformation", "ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    }
  ]
}
