# Copy to .runtime/deployment/storage.env. Used only by local_deployment.py.
# AWS CLI resolves this profile; credentials are kept in ignored backend.env.
AWS_PROFILE=broad
AWS_REGION=us-east-1
REVEAL_S3_BUCKET=cyaka-reveal-data
REVEAL_S3_PREFIX=local/
# EC2 uses the same bucket with REVEAL_S3_PREFIX=prod/ and an instance role.
